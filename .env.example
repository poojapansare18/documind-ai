# Required only for generated RAG answers. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Local embedding and database settings.
DOCUMIND_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCUMIND_DB_PATH=data/documind.db
FASTEMBED_CACHE_PATH=fastembed_cache

# OCR settings (Tesseract and the selected language data must be installed).
DOCUMIND_OCR_LANGUAGE=eng
DOCUMIND_OCR_DPI=200
# Optional: set this to the Tesseract tessdata directory on your machine.
TESSDATA_PREFIX=
